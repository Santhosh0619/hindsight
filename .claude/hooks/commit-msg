#!/usr/bin/env bash
MSG=$(cat "$1")
RED='\033[0;31m'; NC='\033[0m'

# Block AI attribution
for pattern in "Generated by Claude" "Co-authored-by: Claude" "AI-assisted" "claude-code" "Anthropic"; do
  if echo "$MSG" | grep -qi "$pattern"; then
    echo -e "${RED}BLOCKED: AI attribution in commit message: '$pattern'${NC}"
    exit 1
  fi
done

# Conventional commit format
if ! echo "$MSG" | grep -qE '^(feat|fix|refactor|test|docs|chore|perf|ci|style)(\([a-z0-9/_-]+\))?: .{1,100}'; then
  echo -e "${RED}BLOCKED: Not a valid conventional commit message.${NC}"
  echo ""
  echo "Format: <type>(<scope>): <description>"
  echo "Types:  feat | fix | refactor | test | docs | chore | perf | ci | style"
  echo "Example: feat(auth): add rotating refresh token revocation"
  echo ""
  echo "Your message: $MSG"
  exit 1
fi

exit 0
