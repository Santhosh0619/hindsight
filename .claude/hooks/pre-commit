#!/usr/bin/env bash
set -euo pipefail
RED='\033[0;31m'; GREEN='\033[0;32m'; NC='\033[0m'

echo "── pre-commit ───────────────────────────────────────"

# 1. Author identity
AUTHOR_NAME=$(git config user.name 2>/dev/null || echo "")
AUTHOR_EMAIL=$(git config user.email 2>/dev/null || echo "")

for bad in Claude claude Anthropic anthropic Assistant assistant; do
  if echo "$AUTHOR_NAME" | grep -qi "^${bad}$\|${bad} "; then
    echo -e "${RED}BLOCKED: user.name contains AI name: $AUTHOR_NAME${NC}"
    echo "Fix: git config user.name 'Santhosh K'"
    exit 1
  fi
done

for domain in anthropic.com claude.ai; do
  if echo "$AUTHOR_EMAIL" | grep -qi "$domain"; then
    echo -e "${RED}BLOCKED: user.email is an AI domain: $AUTHOR_EMAIL${NC}"
    exit 1
  fi
done
echo -e "${GREEN}✓ Author: $AUTHOR_NAME <$AUTHOR_EMAIL>${NC}"

# 2. AI attribution in staged diff
# Files below are excluded from this scan because their entire purpose is to
# document or detect these exact strings (policy docs, hooks, CI), not to
# attribute authorship to them.
ATTRIBUTION_SCAN_EXCLUDES=( \
  ':!.mailmap' \
  ':!.claude/hooks/commit-msg' \
  ':!.claude/hooks/pre-commit' \
  ':!.claude/skills/git-safety.md' \
  ':!.github/workflows/ci.yml' \
  ':!CLAUDE.md' \
  ':!setup.md' \
  ':!docs/decisions/0001-phase-1-foundation.md' \
)
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || echo "")
FOUND=0
for pattern in \
  "Generated by Claude" \
  "Co-authored-by: Claude" \
  "AI-assisted" \
  "claude-code" \
  "Anthropic Claude" \
  "This code was generated" \
  "AI generated"
do
  if [[ -n "$STAGED" ]] && git diff --cached -- . "${ATTRIBUTION_SCAN_EXCLUDES[@]}" | grep -qF "$pattern"; then
    echo -e "${RED}BLOCKED: AI attribution pattern found: '$pattern'${NC}"
    FOUND=1
  fi
done
[[ $FOUND -eq 1 ]] && exit 1
echo -e "${GREEN}✓ No AI attribution in staged diff${NC}"

# 3. Credential files (".env.example" is the intentional safe template, never blocked)
for file in $STAGED; do
  [[ "$file" == *.env.example ]] && continue
  if echo "$file" | grep -qE '(^|/)\.env(\.|$)|\.pem$|\.key$|\.p12$|\.pfx$|id_rsa|id_ed25519'; then
    echo -e "${RED}BLOCKED: Credential file staged: $file${NC}"
    exit 1
  fi
done

# 4. API key patterns in diff
if git diff --cached | grep -qE '(sk-|AIza|AKIA[0-9A-Z]{16}|ghp_|gho_|ghs_|glpat-)[A-Za-z0-9_-]{16,}'; then
  echo -e "${RED}BLOCKED: Possible API key pattern in staged diff.${NC}"
  exit 1
fi
echo -e "${GREEN}✓ No credentials staged${NC}"

# 5. Prettier on staged frontend files
FE_STAGED=$(echo "$STAGED" | tr ' ' '\n' | grep -E '^frontend/.*\.(ts|tsx|js|jsx|css|json)$' || true)
if [[ -n "$FE_STAGED" ]] && [[ -f "frontend/package.json" ]]; then
  echo "Applying Prettier..."
  echo "$FE_STAGED" | xargs npx --prefix frontend prettier --write --log-level warn 2>/dev/null || true
  echo "$FE_STAGED" | xargs git add
  echo -e "${GREEN}✓ Prettier applied${NC}"
fi

# 6. ruff format on staged Python files
PY_STAGED=$(echo "$STAGED" | tr ' ' '\n' | grep -E '^backend/.*\.py$' || true)
if [[ -n "$PY_STAGED" ]]; then
  echo "Applying ruff format..."
  echo "$PY_STAGED" | xargs ruff format 2>/dev/null || true
  echo "$PY_STAGED" | xargs git add
  echo -e "${GREEN}✓ ruff format applied${NC}"
fi

echo "── pre-commit passed ────────────────────────────────"
exit 0
