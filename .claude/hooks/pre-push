#!/usr/bin/env bash
set -euo pipefail
RED='\033[0;31m'; GREEN='\033[0;32m'; NC='\033[0m'

BRANCH=$(git branch --show-current)
echo "── pre-push [$BRANCH] ───────────────────────────────"

# 1. Block direct push to main
if [[ "$BRANCH" == "main" ]]; then
  echo -e "${RED}BLOCKED: Direct push to main not allowed.${NC}"
  echo "Create a feature branch, push it, and open a PR."
  exit 1
fi

# 2. Author guard
AUTHOR_NAME=$(git config user.name 2>/dev/null || echo "")
if echo "$AUTHOR_NAME" | grep -qiE "(claude|anthropic|assistant)"; then
  echo -e "${RED}BLOCKED: AI name in git user.name: $AUTHOR_NAME${NC}"
  exit 1
fi
echo -e "${GREEN}✓ Branch: $BRANCH | Author: $AUTHOR_NAME${NC}"

# 3. Backend checks — run inside the api container, not on the host. The host
#    has no reason to carry backend/pyproject.toml's dependency set (torch,
#    langchain, etc. — multiple GB), and a native host toolchain silently drifts
#    from the pinned versions in the Docker image (e.g. an old system-wide ruff
#    still enforcing a rule the project's ruff.toml deliberately dropped because
#    the pinned ruff version removed it upstream). docker compose exec runs the
#    exact same command Makefile's test-be target and CI use.
if [[ -d "backend" && -f "backend/pyproject.toml" ]]; then
  echo ""
  echo "Backend checks (in the api container)..."

  if ! docker compose ps --status running --services 2>/dev/null | grep -qx api; then
    echo "  starting db + api..."
    docker compose up -d db api >/dev/null 2>&1 \
      || { echo -e "${RED}BLOCKED: could not start db/api containers for backend checks${NC}"; exit 1; }
  fi

  docker compose exec -T api ruff check . || { echo -e "${RED}BLOCKED: ruff errors${NC}"; exit 1; }
  echo -e "${GREEN}  ✓ ruff${NC}"

  docker compose exec -T api mypy app --strict || { echo -e "${RED}BLOCKED: mypy errors${NC}"; exit 1; }
  echo -e "${GREEN}  ✓ mypy${NC}"

  docker compose exec -T api pytest tests/ -q --tb=short --no-header || { echo -e "${RED}BLOCKED: pytest failures${NC}"; exit 1; }
  echo -e "${GREEN}  ✓ pytest${NC}"
fi

# 4. Frontend checks — run inside the web container, same reasoning as backend's
#    (point 3 above / ADR 0001 §5): no frontend dependency needs installing natively
#    on the host, and hook-pass means the same thing as CI-pass by construction.
if [[ -d "frontend" && -f "frontend/package.json" ]]; then
  echo ""
  echo "Frontend checks (in the web container)..."

  if ! docker compose ps --status running --services 2>/dev/null | grep -qx web; then
    echo "  starting db + api + web..."
    docker compose up -d db api web >/dev/null 2>&1 \
      || { echo -e "${RED}BLOCKED: could not start db/api/web containers for frontend checks${NC}"; exit 1; }
  fi

  docker compose exec -T web npx tsc --noEmit || { echo -e "${RED}BLOCKED: TypeScript errors${NC}"; exit 1; }
  echo -e "${GREEN}  ✓ tsc${NC}"

  docker compose exec -T web npx eslint src --max-warnings 0 || { echo -e "${RED}BLOCKED: eslint errors${NC}"; exit 1; }
  echo -e "${GREEN}  ✓ eslint${NC}"

  docker compose exec -T web npx prettier --check "src/**/*.{ts,tsx,css}" || { echo -e "${RED}BLOCKED: prettier formatting${NC}"; exit 1; }
  echo -e "${GREEN}  ✓ prettier${NC}"

  docker compose exec -T web npx vitest run || { echo -e "${RED}BLOCKED: vitest failures${NC}"; exit 1; }
  echo -e "${GREEN}  ✓ vitest${NC}"

  docker compose exec -T web npx vite build || { echo -e "${RED}BLOCKED: build failed${NC}"; exit 1; }
  echo -e "${GREEN}  ✓ build${NC}"
fi

echo ""
echo "── pre-push passed ──────────────────────────────────"
exit 0
