# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/hindsight
# For local outside Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/hindsight

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ── LLM (all optional — app works without any key) ────────────────────────────
# gemini | groq | ollama
LLM_PROVIDER=gemini
# Gemini: free key at aistudio.google.com (no card). Groq: free key at console.groq.com.
# Leave blank (no trailing comment on the same line -- python-dotenv does not strip an
# inline comment when the value portion is empty, so a trailing "# ..." here becomes
# the literal value instead of being discarded) to run without that provider.
LLM_API_KEY=
# CHECK the current free-tier model ID at the provider before setting this -- do not
# guess, these move fast. Leave blank to use the code default (Settings.llm_model).
LLM_MODEL=

# fallback when Gemini quota exhausted -- leave blank to skip Groq
GROQ_API_KEY=
# for fully local, zero-key mode
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings (no key needed — runs on CPU locally) ──────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── App behaviour ─────────────────────────────────────────────────────────────
DEMO_MODE=true
MAX_UPLOAD_BYTES=10485760
RETRIEVAL_TOP_K=20
RRF_K=60
CRITIC_THRESHOLD=0.7
MAX_CORRECTION_PASSES=2
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── E2E testing ───────────────────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:8000
E2E_FRONTEND_URL=http://localhost:5173
E2E_TEST_USER_EMAIL=e2e-test@hindsight.test
E2E_TEST_USER_PASSWORD=E2eTestPassword123!
