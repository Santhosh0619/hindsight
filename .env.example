# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/hindsight
# For local outside Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/hindsight

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ── LLM (all optional — app works without any key) ────────────────────────────
LLM_PROVIDER=gemini                  # gemini | groq | ollama
LLM_API_KEY=                         # Gemini: free key at aistudio.google.com (no card)
                                     # Groq:   free key at console.groq.com (no card)
LLM_MODEL=                           # CHECK current free-tier model ID at the provider
                                     # Do not guess — model IDs change frequently

GROQ_API_KEY=                        # fallback when Gemini quota exhausted
OLLAMA_BASE_URL=http://localhost:11434  # for fully local, zero-key mode

# ── Embeddings (no key needed — runs on CPU locally) ──────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── App behaviour ─────────────────────────────────────────────────────────────
DEMO_MODE=true
MAX_UPLOAD_BYTES=10485760
RETRIEVAL_TOP_K=20
RRF_K=60
CRITIC_THRESHOLD=0.7
MAX_CORRECTION_PASSES=2
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── E2E testing ───────────────────────────────────────────────────────────────
E2E_BASE_URL=http://localhost:8000
E2E_FRONTEND_URL=http://localhost:5173
E2E_TEST_USER_EMAIL=e2e-test@hindsight.test
E2E_TEST_USER_PASSWORD=E2eTestPassword123!
